# =============================================================
#  AEGIS FORENSICS — Environment Variables
#  Copy this file to .env and fill in the values.
#  Never commit your actual .env file.
# =============================================================

# ── Server Configuration ──────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Optional: External Threat Intelligence APIs ───────────────
# Both are optional. The app runs in offline mode without them.

# VirusTotal API key for URL reputation analysis
# Get one free at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# PhishTank API key for known phishing URL database checks
# Get one free at: https://www.phishtank.com/api_register.php
PHISHTANK_API_KEY=

